{
  "name": "stat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @stat/mobile dev",
    "dev:api": "pnpm --filter @stat/api dev",
    "build": "pnpm --filter @stat/api build && pnpm --filter @stat/mobile build",
    "test": "pnpm --filter @stat/api test && pnpm --filter @stat/mobile test:run",
    "test:api": "pnpm --filter @stat/api test",
    "test:mobile": "pnpm --filter @stat/mobile test:run",
    "typecheck": "pnpm --filter @stat/api typecheck",
    "cap:open": "pnpm --filter @stat/mobile cap:open"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
